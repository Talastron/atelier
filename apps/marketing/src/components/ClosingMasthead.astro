---
// apps/marketing/src/components/ClosingMasthead.astro
//
// Site-wide closing masthead — brass hairlines flanking a small rotated
// brass lozenge, the typeset ATELIER wordmark beneath, then the est.
// MMXXVI · London italic line. Closes long-form pages the way a printed
// catalogue or publication does: the last page-turn carries the imprint.
//
// Used on /about, /pricing, /journal (index), and /journal/[slug]. Pages
// keep their own page-specific closers (END OF CONTENTS · VOLUME I on
// the journal index, Colophon on articles) above this; the masthead is
// the site-wide imprint that bookends every long page.
//
// Visually mirrors the bookend ornament on the /about hero: the page
// opens and closes with the same brass-rule and lozenge composition.
//
// The top padding is the masthead's own and is load-bearing. Without it
// the imprint had no space of its own and inherited whatever the section
// above happened to leave, which was 30px on the home page, 51px on
// /pricing, and on /studio a measured MINUS one: the brass lozenge sat a
// pixel above the "Find the keys" button, inside the 32px drop shadow it
// casts. A closing imprint should not be able to collide with the last
// thing on the page, whatever that thing turns out to be.
---

<div
  class="mx-auto text-center"
  style="max-width: 600px; padding-inline: var(--atelier-page-padding); padding-top: clamp(3.5rem, 5vw, 4.5rem); padding-bottom: clamp(4rem, 6vw, 5rem);"
>
  <div class="flex items-center justify-center gap-4 mb-3">
    <span
      aria-hidden="true"
      style="display: inline-block; width: 32px; height: 1px; background: var(--atelier-brass-300);"
    ></span>
    <span
      aria-hidden="true"
      style="display: inline-block; width: 5px; height: 5px; background: var(--atelier-brass-600); transform: rotate(45deg);"
    ></span>
    <span
      aria-hidden="true"
      style="display: inline-block; width: 32px; height: 1px; background: var(--atelier-brass-300);"
    ></span>
  </div>
  <p
    style="font-family: var(--atelier-font-display); font-size: 0.875rem; letter-spacing: 0.6em; text-indent: 0.6em; color: var(--atelier-brass-text); text-transform: uppercase;"
  >
    Atelier
  </p>
  <p
    class="mt-1"
    style="font-family: var(--atelier-font-display); font-style: italic; font-size: 0.75rem; letter-spacing: 0.18em; color: var(--atelier-stone-500);"
  >
    est. MMXXVI · Surrey
  </p>
</div>
